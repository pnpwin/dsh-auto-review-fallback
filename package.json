{
  "name": "@pnpwin/dsh-auto-review-fallback",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "Independent Auto review models and fail-closed, ordered availability fallbacks for DeepSeek Harness.",
  "license": "MIT",
  "author": "pnpwin",
  "homepage": "https://github.com/pnpwin/dsh-auto-review-fallback#readme",
  "repository": { "type": "git", "url": "git+https://github.com/pnpwin/dsh-auto-review-fallback.git" },
  "bugs": { "url": "https://github.com/pnpwin/dsh-auto-review-fallback/issues" },
  "keywords": ["dsh-plugin", "deepseek-harness", "auto-review", "fallback", "llm", "codex"],
  "icon": "./src/icon.svg",
  "exports": {
    ".": "./src/host.js",
    "./client": "./src/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./src/icon.svg"
  },
  "files": ["src/**", "cordis.patch.yml", "locale/*.json", "README.md", "README.ru.md", "LICENSE", "UPSTREAM.md", "AGENTS.md"],
  "scripts": { "test": "node --test test/*.test.js" },
  "engines": { "node": ">=24.9.0", "dsh": "0.2.2-rc.1" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-settings", "@deepseek-ai/dsh-api-remotes", "@deepseek-ai/dsh-client-locale"]
    }
  }
}
